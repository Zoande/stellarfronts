{
  "name": "space-strategy-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server:dev": "node --env-file=.env --import tsx server/index.ts",
    "auth:dev": "node --env-file=.env --import tsx server/auth-server.ts",
    "orchestrator:dev": "node --env-file=.env --import tsx server/orchestrator.ts",
    "control": "node --env-file=.env --import tsx scripts/control.ts",
    "server:test": "node --import tsx --import ./server/tests/setup.mjs --test server/tests/*.test.ts",
    "combat:balance": "node --import tsx server/game/combat-balance-matrix.ts",
    "dev:all": "concurrently \"npm run server:dev\" \"npm run auth:dev\" \"npm run dev\"",
    "server:typecheck": "tsc -p tsconfig.server.json --noEmit",
    "build": "tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@babylonjs/core": "^7.54.3",
    "@babylonjs/gui": "^7.54.3",
    "@babylonjs/loaders": "^7.54.3",
    "@babylonjs/materials": "^7.54.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "better-sqlite3": "^12.9.0",
    "pureimage": "^0.4.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.15.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
