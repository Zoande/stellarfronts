# StellarFronts Environment Configuration

# ========================================
# LOCAL DEVELOPMENT
# ========================================

# Frontend (Vite dev server)
VITE_AUTH_SERVER_URL=http://localhost:8788
VITE_WS_URL=ws://localhost:8787

# Auth Server
AUTH_SERVER_PORT=8788
AUTH_SERVER_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Required; there is no default. Set this to a long, unique password.
ADMIN_PASSWORD=
DEV_PANEL_PASSWORD=

# Shared internal control credential. Required by both auth and orchestrator.
# Generate a long random value; never expose it to the browser.
CONTROL_TOKEN=
CONTROL_PORT=8790
CONTROL_HOST=127.0.0.1

# Orchestrator public gateway and isolated per-version processes
PUBLIC_GAME_PORT=8787
GATEWAY_HOST=127.0.0.1
DEV_INTERNAL_PORT=8809
VERSION_PORT_BASE=8810
GIT_REMOTE=origin
# Optional absolute durable state root. Defaults to server/state.
# SF_STATE_DIR=
GAME_BACKUP_RETENTION=30
MAX_JSON_BODY_BYTES=8388608

# Game/WebSocket Server
GAME_SERVER_PORT=8787
WS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Session Cookies (local dev: no Secure, no Domain)
# Leave these unset for local development
# COOKIE_DOMAIN=
# COOKIE_SECURE=false

# ========================================
# PRODUCTION (Raspberry Pi / Cloudflare Tunnel)
# ========================================
# Uncomment and set these for production deployment

# Frontend (Cloudflare Pages)
# VITE_AUTH_SERVER_URL=https://api.stellarfronts.com
# VITE_WS_URL=wss://ws.stellarfronts.com

# Auth Server (Raspberry Pi)
# AUTH_SERVER_PORT=8788
# AUTH_SERVER_HOST=127.0.0.1
# ALLOWED_ORIGINS=https://stellarfronts.com,https://www.stellarfronts.com
# ADMIN_PASSWORD=
# DEV_PANEL_PASSWORD=
# CONTROL_TOKEN=
# CONTROL_PORT=8790
# CONTROL_HOST=127.0.0.1

# Game/WebSocket Server (Raspberry Pi)
# PUBLIC_GAME_PORT=8787
# GATEWAY_HOST=127.0.0.1
# DEV_INTERNAL_PORT=8809
# VERSION_PORT_BASE=8810
# WS_ALLOWED_ORIGINS=https://stellarfronts.com,https://www.stellarfronts.com
# SF_STATE_DIR=/var/lib/stellarfronts
# GAME_BACKUP_RETENTION=30

# Session Cookies (production: Secure=true, Domain for cross-subdomain)
# COOKIE_DOMAIN=.stellarfronts.com
# COOKIE_SECURE=true
